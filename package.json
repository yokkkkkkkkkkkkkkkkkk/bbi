const { Client, GatewayIntentBits, Partials, Collection } = require('discord.js');
const { DisTube } = require('distube');
const { SpotifyPlugin } = require('@distube/spotify');
const { SoundCloudPlugin } = require('@distube/soundcloud');
const { YtDlpPlugin } = require('@distube/yt-dlp');
const Database = require('better-sqlite3');
require('dotenv').config();

// Inisialisasi Database SQLite
const db = new Database('database.sqlite');
db.prepare(`
  CREATE TABLE IF NOT EXISTS levels (
    userId TEXT,
    guildId TEXT,
    xp INTEGER,
    level INTEGER,
    PRIMARY KEY (userId, guildId)
  )
`).run();

// Inisialisasi Client Discord
const client = new Client({
  intents: [
    GatewayIntentBits.Guilds,
    GatewayIntentBits.GuildMessages,
    GatewayIntentBits.GuildVoiceStates,
    GatewayIntentBits.MessageContent,
    GatewayIntentBits.GuildMembers
  ],
  partials: [Partials.Channel, Partials.Message, Partials.Reaction]
});

// Inisialisasi DisTube untuk Pemutar Musik
client.distube = new DisTube(client, {
  emitNewSongOnly: true,
  leaveOnFinish: false,
  leaveOnEmpty: true,
  emptyCooldown: 60,
  plugins: [
    new SpotifyPlugin(),
    new SoundCloudPlugin(),
    new YtDlpPlugin()
  ]
});

client.commands = new Collection();
const prefix = '!'; // Ubah prefix sesuai kebutuhan bot Anda

// Event: Bot Ready
client.once('clientReady', () => {
  console.log(`✅ Bot online sebagai ${client.user.tag}`);
  console.log(`📊 Melayani ${client.guilds.cache.size} server`);
});

// Event: Leveling & Pesan Masuk
client.on('messageCreate', async (message) => {
  if (message.author.bot || !message.guild) return;

  // --- Sistem Leveling Sederhana ---
  const userId = message.author.id;
  const guildId = message.guild.id;

  try {
    let row = db.prepare('SELECT * FROM levels WHERE userId = ? AND guildId = ?').get(userId, guildId);
    
    if (!row) {
      db.prepare('INSERT INTO levels (userId, guildId, xp, level) VALUES (?, ?, ?, ?)').run(userId, guildId, 10, 1);
    } else {
      let xp = row.xp + 10;
      let level = row.level;
      let nextLevelXp = level * 100;

      if (xp >= nextLevelXp) {
        level += 1;
        message.channel.Send(`🎉 Selamat ${message.author}, kamu naik ke level **${level}**!`);
      }

      db.prepare('UPDATE levels SET xp = ?, level = ? WHERE userId = ? AND guildId = ?').run(xp, level, userId, guildId);
    }
  } catch (err) {
    console.error('Database Error:', err);
  }

  // --- Sistem Command Teks Dasar ---
  if (!message.content.startsWith(prefix)) return;
  const args = message.content.slice(prefix.length).trim().split(/ +/);
  const command = args.shift().toLowerCase();

  // Command Ping
  if (command === 'ping') {
    message.reply(`Pong! Latensi: \`${client.ws.ping}ms\``);
  }

  // Command Play Musik
  if (command === 'play') {
    const query = args.join(' ');
    if (!query) return message.reply('❌ Masukkan judul lagu atau link yang ingin diputar!');
    if (!message.member.voice.channel) return message.reply('❌ Kamu harus masuk ke *Voice Channel* terlebih dahulu!');

    try {
      client.distube.play(message.member.voice.channel, query, {
        textChannel: message.channel,
        member: message.member,
      });
      message.reply(`🔍 Mencari: \`${query}\``);
    } catch (e) {
      console.error(e);
      message.reply('Terjadi kesalahan saat mencoba memutar musik!');
    }
  }

  // Command Stop Musik
  if (command === 'stop') {
    const queue = client.distube.getQueue(message);
    if (!queue) return message.reply('❌ Tidak ada musik yang sedang diputar!');
    queue.stop();
    message.reply('⏹️ Musik dihentikan dan bot keluar dari *Voice Channel*.');
  }
});

// Event DisTube untuk Notifikasi Musik
client.distube
  .on('playSong', (queue, song) => 
    queue.textChannel.send(`🎶 Sedang memutar: **${song.name}** \`${song.formattedDuration}\` (Diminta oleh: ${song.user})`)
  )
  .on('addSong', (queue, song) => 
    queue.textChannel.send(`✅ Ditambahkan ke antrean: **${song.name}** \`${song.formattedDuration}\``)
  )
  .on('error', (channel, error) => {
    console.error(error);
    if (channel) channel.send(`❌ Terjadi error pada pemutar musik: \`${error.slice(0, 1970)}\``);
  });

// Login Bot menggunakan Token dari Railway Environment Variables
client.login(process.env.DISCORD_TOKEN);
